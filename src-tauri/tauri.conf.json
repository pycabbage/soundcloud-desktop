{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundcloud Desktop",
  "version": "0.1.1-beta.4",
  "identifier": "com.10244.soundcloud-desktop",
  "build": {
    "removeUnusedCommands": true,
    "additionalWatchFolders": [
      "../packages/inject/dist"
    ],
    "beforeDevCommand": "bun run --filter @soundcloud-desktop/inject build",
    "beforeBuildCommand": "bun run --filter @soundcloud-desktop/inject build"
  },
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "id": "main",
      "iconPath": "./icons/app-icon.png",
      "iconAsTemplate": true,
      "title": "Soundcloud Desktop",
      "tooltip": "Soundcloud Desktop",
      "showMenuOnLeftClick": false
    },
    "windows": [
      {
        "title": "Soundcloud Desktop",
        "create": false,
        "width": 1200,
        "height": 800,
        "decorations": false,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "https://soundcloud.com/discover"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "rpm"],
    "createUpdaterArtifacts": true,
    "homepage": "https://github.com/pycabbage/soundcloud-desktop",
    "category": "Music",
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Japanese"],
        "headerImage": "assets/soundcloud_150x57.bmp",
        "sidebarImage": "assets/soundcloud_164x314.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A Soundcloud desktop client."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0MEM0M0EwNjJGQzhCNUEKUldSYWkveGlvRU1NSk52TXRqTllCNVZPRTRCSEJyMjNhYytwU2kyQVlrcDRxbTk4NlhqTXBrUFoK",
      "endpoints": [
        "https://github.com/pycabbage/soundcloud-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
