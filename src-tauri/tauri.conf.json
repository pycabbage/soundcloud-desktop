{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Soundcloud Desktop",
  "version": "0.1.0",
  "identifier": "com.10244.soundcloud-desktop",
  "build": {
    "removeUnusedCommands": true,
    "additionalWatchFolders": [
      "../packages/inject"
    ],
    "beforeDevCommand": "cd packages/inject && bun run build",
    "beforeBuildCommand": "cd packages/inject && bun run build"
  },
  "app": {
    "withGlobalTauri": false,
    "trayIcon": {
      "id": "main",
      "iconPath": "./icons/app-icon.png",
      "iconAsTemplate": true,
      "title": "Soundcloud Desktop",
      "tooltip": "Soundcloud Desktop",
      "showMenuOnLeftClick": false
    },
    "windows": [
      {
        "title": "Soundcloud Desktop",
        "create": false,
        "width": 1200,
        "height": 800,
        "url": "https://soundcloud.com/discover"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
